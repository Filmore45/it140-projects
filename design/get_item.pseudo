START get_item

OUTPUT "Enter the item you want to collect"
INPUT requested_item

IF requested_item is the item in the current room THEN
    ADD requested_item to inventory
    REMOVE requested_item from the current room
    OUTPUT requested_item + " was added to your inventory."
ELSE
    OUTPUT "That item is not in this room."
END IF

OUTPUT "Current inventory: " + inventory

END get_item
