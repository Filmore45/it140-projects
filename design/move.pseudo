START move_between_rooms

SET current_room to "Security Lobby"

WHILE game is still running

    OUTPUT "You are in " + current_room
    OUTPUT "Enter a direction: north, south, east, or west"
    INPUT direction

    IF direction is a valid direction from current_room THEN
        SET current_room to the room in that direction
        OUTPUT "You moved to " + current_room
    ELSE
        OUTPUT "You cannot go that way."
    END IF

END WHILE

END move_between_rooms
